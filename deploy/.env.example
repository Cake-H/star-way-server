# ============================================================
# 生产环境变量模板
# 复制为 .env 并填入真实值：cp .env.example .env
# .env 文件包含敏感信息，切勿提交到 Git！
# ============================================================

# -------------------- ACR 镜像仓库 --------------------
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com
ACR_NAMESPACE=ida

# -------------------- App 服务端口 --------------------
APP_SERVER_PORT=8088
PLUGIN_SERVER_PORT=8089

# -------------------- MySQL 数据库 --------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ida_db
MYSQL_USER=ida_user
MYSQL_PASSWORD=replace_with_strong_password
# 仅在使用 compose 内置 MySQL 时需要
MYSQL_ROOT_PASSWORD=replace_with_root_password
MYSQL_EXPOSE_PORT=3306

# -------------------- Redis --------------------
IDA_REDIS_HOST=127.0.0.1
IDA_REDIS_PORT=6379
IDA_REDIS_PASSWORD=replace_with_redis_password
IDA_REDIS_DB=0
IDA_PLUGIN_REDIS_DB=1
# 仅在使用 compose 内置 Redis 时需要
REDIS_EXPOSE_PORT=6379

# -------------------- 访问域名/IP --------------------
# 前端访问后端 API 的地址（手机联调填局域网 IP，线上填域名）
IDA_ACCESS_HOST=your-domain.com

# -------------------- 阿里云 AK --------------------
# 短信、OSS、语音识别共用同一组 AK
ALIBABA_ACCESS_KEY_ID=replace_with_ak_id
ALIBABA_ACCESS_KEY_SECRET=replace_with_ak_secret

# -------------------- 阿里云 OSS --------------------
# AccessKey 通常与上面 ALIBABA_ACCESS_KEY_ID 共用同一组，直接填相同值即可
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=replace_with_ak_id
ALIYUN_OSS_ACCESS_KEY_SECRET=replace_with_ak_secret
ALIYUN_OSS_BUCKET=your-bucket-name
# 【隐私基线 1.4】Bucket 必须设为「私有读」；简历原件只通过后端签发的预签名 URL（1 小时）访问。
# 公开直链已废弃，本变量保留仅为兼容旧配置，请留空：
ALIYUN_OSS_PUBLIC_BASE_URL=

# -------------------- 阿里云 短信（可选） --------------------
ALIBABA_SMS_ENABLED=false
ALIBABA_SMS_SIGN_NAME=
ALIBABA_SMS_TEMPLATE_CODE=
ALIBABA_DYPNS_SCHEME_NAME=

# -------------------- 阿里云 语音识别 --------------------
ALIYUN_NLS_APP_KEY=replace_with_nls_app_key

# -------------------- 大模型 API Key --------------------
# DeepSeek API（app-server 用）
ARK_API_KEY_DEEPSEEK=replace_with_deepseek_key
# DeepSeek API（plugin-server 用，可共用同一个 key）
ARK_API_KEY=${ARK_API_KEY_DEEPSEEK}

# -------------------- AES 字段加密（生产必填，未配置将启动失败） --------------------
# 主密钥：任意强随机串，建议 openssl rand -hex 16
IDA_AES_FIELD_SECRET=replace_with_random_secret
# 盐：必须恰好 16 位十六进制字符（8 字节），生成：openssl rand -hex 8
IDA_AES_FIELD_SALT_HEX=0123456789abcdef
