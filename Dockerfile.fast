# ============================================================
# 快速 Docker 构建 — 跳过 Docker 内 Maven 编译
# 使用方式：
#   1. mvn package -pl ida-app-server -am -DskipTests -q
#   2. docker build -f Dockerfile.fast --build-arg MODULE=ida-app-server -t 镜像名 .
# MODULE 取值：ida-app-server（8088）/ ida-plugin-server（8089）/ ida-admin-server（8090）
# ============================================================

FROM crpi-57bx5zcp97h0pj85.cn-guangzhou.personal.cr.aliyuncs.com/cakeh/eclipse-temurin:17-jre-alpine

ARG MODULE=ida-app-server

LABEL maintainer="cakeH"
LABEL module=${MODULE}

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

# 直接复制本地已构建好的 JAR（跳过 Docker 内 Maven 编译 ~200s）
COPY ${MODULE}/target/*.jar app.jar

EXPOSE 8088 8089 8090

USER appuser

ENV JAVA_OPTS="-Xms256m -Xmx512m"

ENTRYPOINT ["sh", "-c", "java ${JAVA_OPTS} -jar app.jar --spring.profiles.active=${SPRING_PROFILES_ACTIVE:-prod}"]
